{
  "name": "agora-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "node --env-file-if-exists=.env node_modules/@react-router/dev/bin.cjs dev",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "fake-hub": "node --env-file-if-exists=.env dev/fake-hub.mjs"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0"
  }
}
